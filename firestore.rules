rules_version = '2';

// BolaBate+ — Firestore Security Rules
// Paste this in: Firebase Console → Firestore Database → Rules → Publish
//
// Model:
//  - Everyone signs in (anonymously) and can READ the league data.
//  - Admins are: the bootstrap UID below OR any UID listed in admins/.
//  - Only admins can WRITE cloud/state and manage the admins/ collection.

service cloud.firestore {
  match /databases/{database}/documents {
    function isBootstrapAdmin() {
      return request.auth.uid == "ArLRIkCZT7VNTa7nmvpjUOGpoWh2";
    }

    function isRegisteredAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return request.auth != null && (isBootstrapAdmin() || isRegisteredAdmin());
    }

    // --- Multi-tenant "pelada" model ---
    // Each pelada is its own isolated tenant: peladas/{peladaId} holds its shared
    // id+password metadata, peladas/{peladaId}/admins/{uid} holds who can write that
    // pelada's data (root admin is implicitly admin of every pelada). The old flat
    // isAdmin()/admins/ above stay untouched for now (legacy cloud/state doc) until
    // the post-migration cleanup pass — see the plan this was built from.
    function isPeladaAdmin(peladaId) {
      return isBootstrapAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/peladas/$(peladaId)/admins/$(request.auth.uid)));
    }

    // Root-admin-only "subscription" kill switch: while true, every request below
    // that checks it is denied — including for the pelada's own admins — so this
    // is a real server-side lock, not just a client-side UI gate.
    function isPeladaBlocked(peladaId) {
      // .get('blocked', false) instead of a bare `== true` comparison — peladas
      // created before this field existed (e.g. the migrated "bolabate") have no
      // `blocked` key at all, and comparing a genuinely missing field can fail
      // the whole rule evaluation (denies) instead of just being falsy.
      return get(/databases/$(database)/documents/peladas/$(peladaId)).data.get('blocked', false) == true;
    }

    match /peladas/{peladaId} {
      // get (fetch by known id) is needed to verify a login attempt; list is
      // blocked to non-root admins so the whole tenant list can't be enumerated
      // and its password hashes harvested for offline brute-forcing.
      allow get: if request.auth != null;
      allow list: if isBootstrapAdmin();
      allow create: if isBootstrapAdmin() &&
        !exists(/databases/$(database)/documents/peladas/$(peladaId));
      // A pelada's own admin can still update its metadata (e.g. a future
      // password change), but only the root admin may flip `blocked` — otherwise
      // a blocked pelada's own admin could just unblock themselves.
      allow update: if isBootstrapAdmin() ||
        (isPeladaAdmin(peladaId) && request.resource.data.blocked == resource.data.blocked);
      allow delete: if false;

      match /admins/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if isPeladaAdmin(peladaId);
      }

      // Invite links — a shareable "get in without the shared password" token,
      // generated by any of the pelada's own admins (not root-only, unlike
      // creating a whole new pelada). get-by-known-token is enough for a visitor
      // clicking the link to redeem it; list is admin-only so tokens can't be
      // enumerated. Deleting a doc here is exactly what "revoke" means.
      match /inviteLinks/{token} {
        allow get: if request.auth != null;
        allow list: if isPeladaAdmin(peladaId);
        allow create: if isPeladaAdmin(peladaId);
        allow update: if false;
        allow delete: if isPeladaAdmin(peladaId);
      }
    }

    // Per-pelada league state + avatars, env-split same as the legacy cloud/state
    // below. Doc id is the real peladaId (e.g. "bolabate"), not a fixed name.
    match /cloud/{peladaId} {
      allow read: if request.auth != null && !isPeladaBlocked(peladaId);
      allow write: if isPeladaAdmin(peladaId) && !isPeladaBlocked(peladaId);
      match /avatars/{playerId} {
        allow read, write: if request.auth != null && !isPeladaBlocked(peladaId);
      }
    }
    match /cloud-dev/{peladaId} {
      allow read: if request.auth != null && !isPeladaBlocked(peladaId);
      allow write: if isPeladaAdmin(peladaId) && !isPeladaBlocked(peladaId);
      match /avatars/{playerId} {
        allow read, write: if request.auth != null && !isPeladaBlocked(peladaId);
      }
    }

    // --- Legacy single-tenant model (kept only as an inert backup, until
    // post-migration cleanup) ---
    // These are the pre-migration docs (cloud/state, cloud/state-dev) — nothing
    // in the app reads/writes them anymore. Deliberately scoped to those EXACT
    // doc ids (not a wildcard) so this can never overlap with a real peladaId
    // like "bolabate" — a wildcard here would additively bypass the new
    // isPeladaBlocked() check above for every real pelada, since Firestore ORs
    // every matching rule block for the same path.
    match /cloud/state {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /cloud/state-dev {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin registry — managed by admins from the app's settings screen
    //
    // IMPORTANT: read is open to any authenticated user. This breaks the
    // circular dependency where writing to cloud/state needs isAdmin() which
    // needs exists(admins/{uid}) which needs to READ admins/{uid}. If read
    // required isAdmin(), the exists() check could never succeed for a newly
    // registered admin (chicken-and-egg). The list is not sensitive, so open
    // read is acceptable; writes remain admin-only.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && uid != "ArLRIkCZT7VNTa7nmvpjUOGpoWh2";
    }

    // Player avatars — purely cosmetic (Mii/Duolingo-style creator), so anyone signed
    // in (including anonymous visitors) can read AND write any player's avatar; no
    // admin gating or ownership check. Separate dev/prod collections, same reasoning
    // as cloud/state vs cloud/state-dev above (see src/services/cloudSync.js).
    match /playerAvatars/{playerId} {
      allow read, write: if request.auth != null;
    }
    match /playerAvatars-dev/{playerId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
