rules_version = '2';

// BolaBate+ — Firestore Security Rules
// Paste this in: Firebase Console → Firestore Database → Rules → Publish
//
// Model:
//  - Everyone signs in (anonymously) and can READ the league data.
//  - Admins are: the bootstrap UID below OR any UID listed in admins/.
//  - Only admins can WRITE cloud/state and manage the admins/ collection.

service cloud.firestore {
  match /databases/{database}/documents {
    function isBootstrapAdmin() {
      return request.auth.uid == "ArLRIkCZT7VNTa7nmvpjUOGpoWh2";
    }

    function isRegisteredAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return request.auth != null && (isBootstrapAdmin() || isRegisteredAdmin());
    }

    // --- Multi-tenant "pelada" model ---
    // Each pelada is its own isolated tenant: peladas/{peladaId} holds its shared
    // id+password metadata, peladas/{peladaId}/admins/{uid} holds who can write that
    // pelada's data (root admin is implicitly admin of every pelada). The old flat
    // isAdmin()/admins/ above stay untouched for now (legacy cloud/state doc) until
    // the post-migration cleanup pass — see the plan this was built from.
    function isPeladaAdmin(peladaId) {
      return isBootstrapAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/peladas/$(peladaId)/admins/$(request.auth.uid)));
    }

    match /peladas/{peladaId} {
      // get (fetch by known id) is needed to verify a login attempt; list is
      // blocked to non-root admins so the whole tenant list can't be enumerated
      // and its password hashes harvested for offline brute-forcing.
      allow get: if request.auth != null;
      allow list: if isBootstrapAdmin();
      allow create: if isBootstrapAdmin() &&
        !exists(/databases/$(database)/documents/peladas/$(peladaId));
      allow update: if isPeladaAdmin(peladaId);
      allow delete: if false;

      match /admins/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if isPeladaAdmin(peladaId);
      }
    }

    // Per-pelada league state + avatars, env-split same as the legacy cloud/state
    // below. Doc id is the real peladaId (e.g. "bolabate"), not a fixed name.
    match /cloud/{peladaId} {
      allow read: if request.auth != null;
      allow write: if isPeladaAdmin(peladaId);
      match /avatars/{playerId} {
        allow read, write: if request.auth != null;
      }
    }
    match /cloud-dev/{peladaId} {
      allow read: if request.auth != null;
      allow write: if isPeladaAdmin(peladaId);
      match /avatars/{playerId} {
        allow read, write: if request.auth != null;
      }
    }

    // --- Legacy single-tenant model (kept until post-migration cleanup) ---
    // The whole league state lives in one document: cloud/state (prod) or
    // cloud/state-dev (dev Vercel deployment + local `npm run dev` — see
    // src/services/firebase.js IS_DEV_ENVIRONMENT / cloudSync.js CLOUD_DOC_ID).
    // Same rule for both: any signed-in user can read, only admins can write.
    match /cloud/{stateId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin registry — managed by admins from the app's settings screen
    //
    // IMPORTANT: read is open to any authenticated user. This breaks the
    // circular dependency where writing to cloud/state needs isAdmin() which
    // needs exists(admins/{uid}) which needs to READ admins/{uid}. If read
    // required isAdmin(), the exists() check could never succeed for a newly
    // registered admin (chicken-and-egg). The list is not sensitive, so open
    // read is acceptable; writes remain admin-only.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && uid != "ArLRIkCZT7VNTa7nmvpjUOGpoWh2";
    }

    // Player avatars — purely cosmetic (Mii/Duolingo-style creator), so anyone signed
    // in (including anonymous visitors) can read AND write any player's avatar; no
    // admin gating or ownership check. Separate dev/prod collections, same reasoning
    // as cloud/state vs cloud/state-dev above (see src/services/cloudSync.js).
    match /playerAvatars/{playerId} {
      allow read, write: if request.auth != null;
    }
    match /playerAvatars-dev/{playerId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
